# Shared/local summarization
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-2.6-flash
# Set this in hosted deployments to pin requests to one provider.
OPENROUTER_PROVIDER=
# Optional path to a redact-ner-compatible ONNX model.
AISSENCE_NER_MODEL=

# Server and local Supabase
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
SUPABASE_AUTH_URL=http://127.0.0.1:55421/auth/v1
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=replace-with-the-local-supabase-jwt-secret
AISSENCE_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
AISSENCE_PUBLIC_URL=http://127.0.0.1:8787
AISSENCE_BIND=127.0.0.1:8787
AISSENCE_TOKEN_ISSUER=aissence-server
AISSENCE_TOKEN_AUDIENCE=aissence-cli
AISSENCE_ACCESS_TOKEN_SECONDS=900
AISSENCE_REFRESH_TOKEN_DAYS=30

# Abuse and resource limits
AISSENCE_MAX_UPLOAD_BYTES=33554432
AISSENCE_MAX_COMMITS=2000
AISSENCE_MAX_MESSAGES_PER_COMMIT=2000
AISSENCE_MAX_ENTRY_CHARS=65536
AISSENCE_DAILY_REQUEST_LIMIT=2000
AISSENCE_DAILY_GLOBAL_REQUEST_LIMIT=10000
AISSENCE_DAILY_USER_INPUT_CHARS=5000000
AISSENCE_DAILY_GLOBAL_INPUT_CHARS=50000000
